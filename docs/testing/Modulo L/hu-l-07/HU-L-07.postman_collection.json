    {
      "name": "Gerente — GET, preparar selección",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_gerente}}"
          }
        ],
        "url": "{{baseUrl}}/api/materias/tarifas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Sin error\", () => pm.expect(body.error).to.eql(null));",
              "pm.test(\"Lista y DTO\", () => { pm.expect(body.data.items).to.be.an(\"array\"); body.data.items.forEach(x => { pm.expect(x).to.have.all.keys(\"id\",\"nombre\",\"codigo\",\"tarifa_hora\"); pm.expect(x.tarifa_hora === null || Number.isInteger(x.tarifa_hora)).to.eql(true); }); });",
              "pm.test(\"Precondición: hay materias activas para seleccionar\", () => pm.expect(body.data.items.length).to.be.above(0));",
              "const inactiva = pm.collectionVariables.get(\"materiaInactivaId\");",
              "pm.test(\"Precondición: materiaInactivaId configurada con una materia inactiva real\", () => pm.expect(inactiva).to.be.a(\"string\").and.not.be.empty);",
              "pm.test(\"Las materias inactivas no se listan (CA6)\", () => pm.expect(body.data.items.map(x => x.id)).to.not.include(inactiva));",
              "pm.test(\"Sin materias repetidas\", () => pm.expect(new Set(body.data.items.map(x => x.id)).size).to.eql(body.data.items.length));",
              "pm.collectionVariables.set(\"tarifasAntes\", JSON.stringify(Object.fromEntries(body.data.items.map(x => [x.id, x.tarifa_hora]))));",
              "if (body.data.items.length) { const elegidas = body.data.items.slice(0,3); pm.collectionVariables.set(\"materiaId\",elegidas[0].id); pm.collectionVariables.set(\"tarifaActual\",JSON.stringify(elegidas[0].tarifa_hora)); pm.collectionVariables.set(\"materias\",JSON.stringify(elegidas.map(x => ({id:x.id,tarifa_actual:x.tarifa_hora})))); }"
            ]
          }
        }
      ]
    },

              "pm.test(\"Todas las seleccionadas quedaron con la tarifa nueva\", () => { const nueva = Number(pm.collectionVariables.get(\"nuevaTarifa\")); const m = JSON.parse(pm.collectionVariables.get(\"materias\")); m.forEach(a => { const ahora = body.data.items.find(x => x.id === a.id); pm.expect(ahora, a.id).to.be.an(\"object\"); pm.expect(ahora.tarifa_hora).to.eql(nueva); }); });",

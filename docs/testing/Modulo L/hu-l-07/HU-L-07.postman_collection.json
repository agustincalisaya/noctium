    {
      "name": "Gerente — cambio masivo (preparar null/iguales/distintas)",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_gerente}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/materias/tarifas",
        "body": {
          "mode": "raw",
          "raw": "{\"tarifa_hora\":{{nuevaTarifa}},\"materias\":{{materias}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Sin error\", () => pm.expect(body.error).to.eql(null));",
              "pm.test(\"Precondición: al menos una seleccionada con tarifa distinta de nuevaTarifa\", () => { const m = JSON.parse(pm.collectionVariables.get(\"materias\")); const nueva = Number(pm.collectionVariables.get(\"nuevaTarifa\")); pm.expect(m.filter(x => x.tarifa_actual !== nueva).length).to.be.above(0); });",
              "pm.test(\"Forma de la respuesta\", () => { pm.expect(body.data).to.have.all.keys(\"tarifa_hora\", \"actualizadas\", \"sin_cambio\"); });",
              "pm.test(\"Actualizadas + sin cambio = seleccionadas\", () => pm.expect(body.data.actualizadas + body.data.sin_cambio).to.eql(JSON.parse(pm.collectionVariables.get(\"materias\")).length));",
              "pm.test(\"Hubo al menos una actualizada\", () => pm.expect(body.data.actualizadas).to.be.above(0));",
              "pm.test(\"Resultado masivo\",()=>{ const m=JSON.parse(pm.collectionVariables.get(\"materias\")); const nueva=Number(pm.collectionVariables.get(\"nuevaTarifa\")); pm.expect(body.data.tarifa_hora).to.eql(nueva); pm.expect(body.data.actualizadas).to.eql(m.filter(x=>x.tarifa_actual!==nueva).length); pm.expect(body.data.sin_cambio).to.eql(m.filter(x=>x.tarifa_actual===nueva).length); });",
              "if(body.data){ const m=JSON.parse(pm.collectionVariables.get(\"materias\")); pm.collectionVariables.set(\"materiasNoop\",JSON.stringify(m.map(x=>({id:x.id,tarifa_actual:body.data.tarifa_hora})))); }"
            ]
          }
        }
      ]
    },

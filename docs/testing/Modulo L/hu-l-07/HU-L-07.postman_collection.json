      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Las seleccionadas conservan la tarifa que tenían antes de los 400, 404, 409 y 422\", () => { const antes = JSON.parse(pm.collectionVariables.get(\"materias\")); pm.expect(antes.length).to.be.above(0); antes.forEach(a => { const ahora = body.data.items.find(x => x.id === a.id); pm.expect(ahora, a.id).to.be.an(\"object\"); pm.expect(ahora.tarifa_hora).to.eql(a.tarifa_actual); }); });",
              "pm.test(\"Ninguna materia cambió de tarifa\", () => { const antes = JSON.parse(pm.collectionVariables.get(\"tarifasAntes\")); body.data.items.forEach(x => pm.expect(x.tarifa_hora, x.id).to.eql(antes[x.id])); });",
              "pm.test(\"La inactiva sigue sin listarse\", () => pm.expect(body.data.items.map(x => x.id)).to.not.include(pm.collectionVariables.get(\"materiaInactivaId\")));"
            ]
          }
        }
      ]

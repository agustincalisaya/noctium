  "item": [
    {
      "name": "01 GET aulas libres — 200 ordenadas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/turnos/generacion/aulas-libres?fecha={{fecha_desde}}&hora_inicio={{hora_inicio}}&duracion_min=60",
        "description": "Aulas activas libres en esa fecha y horario, por capacidad ascendente, nombre e id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test(\"Envelope {data, error}\", () => pm.expect(b).to.have.keys(\"data\", \"error\"));",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lista con id, nombre y capacidad\", () => { pm.expect(b.data).to.be.an(\"array\"); b.data.forEach((a) => pm.expect(a).to.have.keys(\"id\", \"nombre\", \"capacidad\")); });",
              "pm.test(\"Orden por capacidad ascendente\", () => { const c = b.data.map((a) => a.capacidad); pm.expect(c).to.eql([...c].sort((x, y) => x - y)); });"
            ]
          }
        }
      ]
    },

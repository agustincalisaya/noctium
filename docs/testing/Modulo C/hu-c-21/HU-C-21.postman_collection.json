        "body": {
          "mode": "raw",
          "raw": "{\n  \"materia_id\": \"{{materia_id}}\",\n  \"profesor_id\": \"{{profesor_id}}\",\n  \"horario_id\": \"{{horario_id}}\",\n  \"duracion_min\": 60,\n  \"hora_inicio\": \"{{hora_inicio}}\",\n  \"aula_id\": \"{{aula_id}}\",\n  \"fecha_desde\": \"{{fecha_desde}}\",\n  \"fecha_hasta\": \"{{fecha_hasta}}\",\n  \"resolver_automaticamente\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test(\"Envelope {data, error}\", () => pm.expect(b).to.have.keys(\"data\", \"error\"));",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cada fecha suma los campos de HU-C-21\", () => b.data.fechas.forEach((f) => pm.expect(f).to.include.keys(\"fecha\", \"estado\", \"motivos\", \"aula\", \"aula_cambiada\", \"cupo\", \"cupo_aula_por_defecto\", \"excluida\", \"sin_aulas_libres\", \"solo_excluible\")));",
              "const resuelta = b.data.fechas.find((f) => f.fecha === pm.variables.get(\"fecha_conflicto\"));",
              "pm.test(\"Fecha ocupada resuelta\", () => { pm.expect(resuelta.estado).to.eql(\"OK\"); pm.expect(resuelta.aula_cambiada).to.eql(true); });",
              "pm.test(\"Nunca un aula más chica\", () => pm.expect(resuelta.cupo).to.be.at.least(resuelta.cupo_aula_por_defecto));"
            ]
          }
        }
      ]
    },

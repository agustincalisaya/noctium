    {
      "name": "05 POST vista previa — 200 pedido de Sprint 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/turnos/generacion/vista-previa",
        "description": "Sin campos nuevos: misma respuesta de Sprint 2 más los campos de HU-C-21. No escribe.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"materia_id\": \"{{materia_id}}\",\n  \"profesor_id\": \"{{profesor_id}}\",\n  \"horario_id\": \"{{horario_id}}\",\n  \"duracion_min\": 60,\n  \"hora_inicio\": \"{{hora_inicio}}\",\n  \"aula_id\": \"{{aula_id}}\",\n  \"fecha_desde\": \"{{fecha_desde}}\",\n  \"fecha_hasta\": \"{{fecha_hasta}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test(\"Envelope {data, error}\", () => pm.expect(b).to.have.keys(\"data\", \"error\"));",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resumen de Sprint 2 + conteos nuevos\", () => pm.expect(b.data).to.include.keys(\"cantidad\", \"fechas\", \"hay_conflictos\", \"fechas_omitidas_vencidas\", \"cantidad_incluida\", \"con_aula_cambiada\", \"excluidas\"));",
              "pm.test(\"Cada fecha suma los campos de HU-C-21\", () => b.data.fechas.forEach((f) => pm.expect(f).to.include.keys(\"fecha\", \"estado\", \"motivos\", \"aula\", \"aula_cambiada\", \"cupo\", \"cupo_aula_por_defecto\", \"excluida\", \"sin_aulas_libres\", \"solo_excluible\")));",
              "pm.test(\"Sin elecciones: ninguna cambiada ni excluida\", () => { pm.expect(b.data.con_aula_cambiada).to.eql(0); pm.expect(b.data.excluidas).to.eql(0); pm.expect(b.data.cantidad_incluida).to.eql(b.data.cantidad); });",
              "pm.test(\"La fecha con el aula ocupada tiene AULA_OCUPADA\", () => pm.expect(b.data.fechas.find((f) => f.fecha === pm.variables.get(\"fecha_conflicto\")).motivos).to.include(\"AULA_OCUPADA\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 POST vista previa — 200 con aula por fecha y exclusión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/turnos/generacion/vista-previa",
        "description": "aulas_por_fecha resuelve la fecha ocupada; fechas_excluidas saca otra. No escribe.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"materia_id\": \"{{materia_id}}\",\n  \"profesor_id\": \"{{profesor_id}}\",\n  \"horario_id\": \"{{horario_id}}\",\n  \"duracion_min\": 60,\n  \"hora_inicio\": \"{{hora_inicio}}\",\n  \"aula_id\": \"{{aula_id}}\",\n  \"fecha_desde\": \"{{fecha_desde}}\",\n  \"fecha_hasta\": \"{{fecha_hasta}}\",\n  \"aulas_por_fecha\": [\n    {\n      \"fecha\": \"{{fecha_conflicto}}\",\n      \"aula_id\": \"{{aula_cambiada_id}}\"\n    }\n  ],\n  \"fechas_excluidas\": [\n    \"{{fecha_excluida}}\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test(\"Envelope {data, error}\", () => pm.expect(b).to.have.keys(\"data\", \"error\"));",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cada fecha suma los campos de HU-C-21\", () => b.data.fechas.forEach((f) => pm.expect(f).to.include.keys(\"fecha\", \"estado\", \"motivos\", \"aula\", \"aula_cambiada\", \"cupo\", \"cupo_aula_por_defecto\", \"excluida\", \"sin_aulas_libres\", \"solo_excluible\")));",
              "const cambiada = b.data.fechas.find((f) => f.fecha === pm.variables.get(\"fecha_conflicto\"));",
              "const excluida = b.data.fechas.find((f) => f.fecha === pm.variables.get(\"fecha_excluida\"));",
              "pm.test(\"Fecha cambiada: OK con el aula y el cupo nuevos\", () => { pm.expect(cambiada.estado).to.eql(\"OK\"); pm.expect(cambiada.aula_cambiada).to.eql(true); pm.expect(cambiada.aula.id).to.eql(pm.variables.get(\"aula_cambiada_id\")); });",
              "pm.test(\"Fecha excluida: OK, sin motivos\", () => { pm.expect(excluida.excluida).to.eql(true); pm.expect(excluida.estado).to.eql(\"OK\"); pm.expect(excluida.motivos).to.eql([]); });",
              "pm.test(\"Resumen\", () => { pm.expect(b.data.con_aula_cambiada).to.eql(1); pm.expect(b.data.excluidas).to.eql(1); pm.expect(b.data.cantidad_incluida).to.eql(b.data.cantidad - 1); });"
            ]
          }
        }
      ]
    },

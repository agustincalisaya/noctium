    {
      "name": "Cancelar inscripción pagada — 200",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_alumno}}"
          }
        ],
        "url": "{{baseUrl}}/api/turnos/{{turno_pagada}}/inscripcion/cancelacion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Sin error\", () => pm.expect(body.error).to.eql(null));",
              "pm.test(\"Contrato exacto\", () => { pm.expect(body.data).to.have.all.keys(\"id\", \"inscripcion_id\", \"vigencia\", \"con_pagos\", \"alumnos_inscriptos\", \"estado\"); });",
              "pm.test(\"Finaliza como CANCELADA_ALUMNO con pagos\", () => { pm.expect(body.data.id).to.eql(pm.collectionVariables.get(\"turno_pagada\")); pm.expect(body.data.inscripcion_id).to.be.a(\"string\").and.not.empty; pm.expect(body.data.vigencia).to.eql(\"CANCELADA_ALUMNO\"); pm.expect(body.data.con_pagos).to.eql(true); });",
              "pm.test(\"Cupo liberado\", () => { pm.expect(body.data.alumnos_inscriptos).to.match(/^\\d+\\/\\d+$/); const [inscriptos, cupo] = body.data.alumnos_inscriptos.split(\"/\").map(Number); pm.expect(inscriptos).to.be.below(cupo); });",
              "pm.test(\"Estado de la clase\", () => pm.expect([\"DISPONIBLE\", \"COMPLETO\"]).to.include(body.data.estado));",
              "pm.test(\"Sin caché\", () => pm.expect(pm.response.headers.get(\"Cache-Control\") || \"\").to.include(\"no-store\"));",
              "pm.collectionVariables.set(\"inscripcion_cancelada\", body.data.inscripcion_id);"
            ]
          }
        }
      ]

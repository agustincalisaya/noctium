  "item": [
    {
      "name": "Sin sesión — 401",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/turnos/{{turno_pagada}}/inscripcion/cancelacion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Código SESION_INVALIDA\", () => { pm.expect(body.data).to.eql(null); pm.expect(body.error.code).to.eql(\"SESION_INVALIDA\"); });",
              "pm.test(\"Mensaje\", () => pm.expect(body.error.message).to.be.a(\"string\").and.not.empty);",
              "pm.test(\"Sin caché\", () => pm.expect(pm.response.headers.get(\"Cache-Control\") || \"\").to.include(\"no-store\"));"
            ]
          }
        }
      ]
    },

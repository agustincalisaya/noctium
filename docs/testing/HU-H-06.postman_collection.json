{
  "info": {
    "name": "Noctium HU-H-06",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Variables de cookies se suministran localmente; no contiene secretos. SQL contrasta la ocupaci\u00f3n real del mismo per\u00edodo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "desde",
      "value": "2024-11"
    },
    {
      "key": "hasta",
      "value": "2026-10"
    },
    {
      "key": "cookieGerente",
      "value": ""
    },
    {
      "key": "cookieMesa",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Resumen gerente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookieGerente}}"
          }
        ],
        "url": "{{baseUrl}}/api/indicadores/ocupacion-resumen?desde={{desde}}&hasta={{hasta}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const cuerpo = pm.response.json();",
              "pm.test(\"Shape est\u00e1ndar\", () => { pm.expect(cuerpo).to.have.property(\"data\"); pm.expect(cuerpo).to.have.property(\"error\"); });",
              "pm.test(\"\u00c9xito\", () => pm.expect(cuerpo.error).to.eql(null));",
              "pm.test(\"Resumen tipado\", () => { pm.expect(cuerpo.data.ocupacion_promedio).to.be.a(\"number\"); pm.expect(cuerpo.data.turnos).to.be.a(\"number\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingresos compatible",
      "request": {

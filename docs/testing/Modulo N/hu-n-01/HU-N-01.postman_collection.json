    {
      "name": "Concurrencia — dos lecturas Gerente",
      "description": "Ejecutar en orden con sesión Gerente sobre una base de prueba. El segundo PUT usa el snapshot inicial; intenta cambiar cancelación antes que plazo en el orden alfabético para probar rollback.",
      "item": [
        {
          "name": "01 Snapshot de ambos editores",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/configuracion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const v=Object.fromEntries(pm.response.json().data.parametros.map(p=>[p.campo,p.valor]));",
                  "Object.entries(v).forEach(([k,x])=>pm.collectionVariables.set('stale_'+k,x));",
                  "const primero=v.plazoPagoHoras===24?48:24;pm.collectionVariables.set('primer_pago',primero);pm.collectionVariables.set('segundo_pago',primero===36?48:36);",
                  "pm.collectionVariables.set('nueva_cancelacion',v.cancelacionAnticipacionHoras===24?48:24);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Primer editor guarda plazo",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/configuracion",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"valores\":{\"plazoPagoHoras\":{{primer_pago}},\"cancelacionAnticipacionHoras\":{{stale_cancelacionAnticipacionHoras}},\"umbralPresentismo\":{{stale_umbralPresentismo}}},\"esperados\":{\"plazoPagoHoras\":{{stale_plazoPagoHoras}},\"cancelacionAnticipacionHoras\":{{stale_cancelacionAnticipacionHoras}},\"umbralPresentismo\":{{stale_umbralPresentismo}}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Segundo editor intenta dos cambios con snapshot viejo",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/configuracion",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"valores\":{\"plazoPagoHoras\":{{segundo_pago}},\"cancelacionAnticipacionHoras\":{{nueva_cancelacion}},\"umbralPresentismo\":{{stale_umbralPresentismo}}},\"esperados\":{\"plazoPagoHoras\":{{stale_plazoPagoHoras}},\"cancelacionAnticipacionHoras\":{{stale_cancelacionAnticipacionHoras}},\"umbralPresentismo\":{{stale_umbralPresentismo}}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 sin parcial',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().error.code).to.eql('CONFLICTO_EDICION_CONCURRENTE');});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Confirmar rollback",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/configuracion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y cancelación intacta',()=>{pm.response.to.have.status(200);const v=Object.fromEntries(pm.response.json().data.parametros.map(p=>[p.campo,p.valor]));pm.expect(v.plazoPagoHoras).to.eql(Number(pm.collectionVariables.get('primer_pago')));pm.expect(v.cancelacionAnticipacionHoras).to.eql(Number(pm.collectionVariables.get('stale_cancelacionAnticipacionHoras')));});"
                ]
              }
            }
          ]
        }
      ]
    },

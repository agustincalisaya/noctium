{
  "info": {
    "name": "HU-E-09 — asistencia individual",
    "description": "Casos independientes: restaurar base descartable o seleccionar otro turno sin registrar para casos 6/7. Caso 8 cambia la cookie/rol y el turno; caso 9 requiere turno futuro DISPONIBLE. No registrar estas acciones en una base del equipo. Contratos ejecutables también por Playwright autenticado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "turnoId",
      "value": ""
    },
    {
      "key": "alumno1",
      "value": ""
    },
    {
      "key": "alumno2",
      "value": ""
    },
    {
      "key": "alumno3",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Alta con asistencia (clase no registrada)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/turnos/{{turnoId}}/clase-dictada",
        "description": "Usar cookie de sesión NextAuth del rol documentado. IDs se resuelven con HU-E-09.sql; no CUID obligatorio.",
        "body": {
          "mode": "raw",
          "raw": "{\"asistencias\":[{\"alumno_id\":\"{{alumno1}}\",\"estado\":\"PRESENTE\"},{\"alumno_id\":\"{{alumno2}}\",\"estado\":\"AUSENTE\"},{\"alumno_id\":\"{{alumno3}}\",\"estado\":\"PRESENTE\"}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.test(\"Sobre estándar\", () => { pm.expect(r).to.have.keys(\"data\", \"error\"); });"
            ]
          }
        }
      ]
    },

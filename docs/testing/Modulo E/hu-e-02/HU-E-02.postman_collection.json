        "url": "{{base_url}}/api/alumnos/{{alumno_id}}/clases?desde=2026-09-21&hasta=2026-09-23&resultado=ASISTIO"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [

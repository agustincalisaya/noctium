              "pm.test(\"Cada mes trae ocupacion_promedio numérico (0 si no hay datos)\", () => body.data.forEach((f) => pm.expect(f.ocupacion_promedio).to.be.a(\"number\")));"
            ]
          }
        }
      ]
    },
    {

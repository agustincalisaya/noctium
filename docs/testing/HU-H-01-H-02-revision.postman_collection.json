{
  "info": {
    "name": "Noctium HU-H-01/H-02 revisadas — Indicadores (Ingresos y Ocupación)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar SOLO en base aislada. Autenticarse desde la UI (o /api/auth/callback/credentials) y usar las cookies de sesión: Gerente para 1-3, Mesa de Entrada para 4, ninguna sesión para 5. No contiene credenciales. Solo lectura: no altera datos."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "desde",
      "value": "2026-05"
    },
    {
      "key": "hasta",
      "value": "2026-10"
    }
  ],
  "item": [
    {
      "name": "1. Ingresos, rango con datos (sesión Gerente)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/indicadores/ingresos-por-mes?desde={{desde}}&hasta={{hasta}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Sobre estándar { data, error }\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Sin error\", () => pm.expect(body.error).to.eql(null));",
              "pm.test(\"Un elemento por mes, en orden, sin omitir meses\", () => { const meses = body.data.map((f) => f.mes); pm.expect(meses).to.eql([...meses].sort()); pm.expect(new Set(meses).size).to.eql(meses.length); });",
              "pm.test(\"Cada mes trae total numérico (0 si no hay datos)\", () => body.data.forEach((f) => pm.expect(f.total).to.be.a(\"number\")));"
            ]
          }
        }
      ]
    },
    {

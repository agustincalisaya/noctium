            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test(\"Sobre estándar { data, error }\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"error.code = VALIDATION_ERROR\", () => pm.expect(body.error.code).to.eql(\"VALIDATION_ERROR\"));",
              "pm.test(\"data = null\", () => pm.expect(body.data).to.eql(null));"
            ]

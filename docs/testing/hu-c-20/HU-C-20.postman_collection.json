  "item": [
    {
      "name": "GET resumen, sesión ALUMNO vinculada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/turnos/{{turno_id}}/inscripcion/resumen",
        "description": "Usar el id del caso y la sesión indicada en un entorno de prueba aislado. GET no debe mutar: contrastar SQL antes/después."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope\", () => { pm.expect(body).to.have.keys(\"data\", \"error\"); });",
              "pm.test(\"No cache\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store, must-revalidate\"));",
              "pm.test(\"Sin error\", () => pm.expect(body.error).to.eql(null));",
              "pm.test(\"Resumen completo\", () => { pm.expect(body.data).to.have.keys(\"turno_id\",\"materia\",\"profesor\",\"fecha\",\"hora_inicio\",\"hora_fin\",\"duracion_min\",\"aula\",\"cupo\",\"lugares_disponibles\",\"precio\",\"plazo_pago_horas\",\"vence_pago_el\",\"limite_cancelacion_en_linea\",\"limite_cancelacion_pasado\"); });",
              "pm.test(\"Interino null\", () => { pm.expect(body.data.plazo_pago_horas).to.eql(null); pm.expect(body.data.vence_pago_el).to.eql(null); });",
              "pm.test(\"Fechas y enteros\", () => { pm.expect(body.data.fecha).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(body.data.hora_inicio).to.match(/^\\d{2}:\\d{2}$/); pm.expect(body.data.hora_fin).to.match(/^\\d{2}:\\d{2}$/); pm.expect(body.data.limite_cancelacion_en_linea).to.match(/-03:00$/); [\"duracion_min\",\"cupo\",\"lugares_disponibles\",\"precio\"].forEach(k => pm.expect(Number.isInteger(body.data[k])).to.eql(true)); });"
            ]
          }
        }
      ]
    },

{
  "info": {
    "name": "Noctium HU-I-01 Registrar pago",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar SOLO en base aislada. Autenticar desde la UI y usar las cookies de sesión. Completar alumno_id (inscripto), fecha_pago (hoy en Argentina) y fixtures desde opciones/BD. Los dos últimos requests requieren cambiar o limpiar sesión. No contiene credenciales ni altera pagos existentes."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "turno_id",
      "value": "seed-turno-02"
    },
    {
      "key": "alumno_id",
      "value": ""
    },
    {
      "key": "forma_pago_id",
      "value": "formapago-efectivo"
    },
    {
      "key": "fecha_pago",
      "value": ""
    },
    {
      "key": "alumno_no_inscripto_id",
      "value": "c123456789012345678901234"
    },
    {
      "key": "forma_inactiva_id",
      "value": ""
    },
    {
      "key": "turno_pendiente_id",
      "value": "seed-turno-11"
    },
    {
      "key": "turno_cancelado_id",
      "value": "seed-turno-09"
    }
  ],
  "item": [
    {
      "name": "Opciones del turno (sesión Mesa)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/pagos/opciones?turno_id={{turno_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Sobre estándar\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Sin error\", () => pm.expect(body.error).to.eql(null));"
            ]
          }
        }
      ]
    },

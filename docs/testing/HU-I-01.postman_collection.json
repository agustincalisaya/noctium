            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "const body = pm.response.json();",
              "pm.test(\"Sobre estándar\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Código SIN_PERMISO\", () => pm.expect(body.error.code).to.eql(\"SIN_PERMISO\"));"
            ]
          }
        }
      ]
    }
  ]

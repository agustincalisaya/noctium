    {
      "name": "cancelaciones-por-mes — Rango por defecto",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_gerente}}"
          }
        ],
        "url": "{{base_url}}/api/indicadores/cancelaciones-por-mes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sobre estándar\", () => { const r = pm.response.json(); pm.expect(r).to.have.keys(\"data\", \"error\"); });",
              "pm.test(\"Series y tasas separadas\", () => { const d = pm.response.json().data; pm.expect(d).to.have.keys(\"meses\", \"totales\", \"tasas\"); pm.expect(d.totales).to.have.keys(\"clases_canceladas_centro\", \"inscripciones_canceladas_alumno\", \"reservas_vencidas\", \"bajas\"); for (const t of Object.values(d.tasas)) { pm.expect(t.tasa === null || Number.isFinite(t.tasa)).to.be.true; if (t.totales === 0) pm.expect(t.tasa).to.equal(null); } });"
            ]
          }
        }
      ]
    },

        {
          "name": "A01 mesa2 · POST operación de 2 clases por transferencia · 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/pagos/operaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alumno_id\": \"{{alumno_id}}\",\n  \"items\": [\n    {\n      \"inscripcion_id\": \"{{insc_1}}\",\n      \"monto\": \"{{precio}}\"\n    },\n    {\n      \"inscripcion_id\": \"{{insc_2}}\",\n      \"monto\": \"{{precio}}\"\n    }\n  ],\n  \"forma_pago_id\": \"formapago-transferencia\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const precio = Number(pm.environment.get('precio'));",
                  "pm.environment.set('precio_dec', precio.toFixed(2));",
                  "pm.environment.set('monto_mesa', String(precio - 1000));",
                  "pm.environment.set('monto_mesa_dec', (precio - 1000).toFixed(2));",
                  "pm.environment.set('monto_gerente', String(precio - 2000));",
                  "pm.environment.set('monto_gerente_dec', (precio - 2000).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('sobre { data, error: null }', () => pm.expect(pm.response.json().error).to.eql(null));",
                  "const pagos = pm.response.json().data.pagos;",
                  "pm.test('dos pagos', () => pm.expect(pagos).to.have.length(2));",
                  "pm.environment.set('pago_1', pagos.find((p) => p.inscripcion_id === pm.environment.get('insc_1')).id);",
                  "pm.environment.set('pago_2', pagos.find((p) => p.inscripcion_id === pm.environment.get('insc_2')).id);",
                  "pm.environment.set('operacion_id', pm.response.json().data.operacion_id);"
                ]
              }
            }
          ]
        },
        {

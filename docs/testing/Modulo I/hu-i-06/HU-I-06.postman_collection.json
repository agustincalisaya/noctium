            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sobre { data, error: null }', () => pm.expect(pm.response.json().error).to.eql(null));",
                  "const d = pm.response.json().data;",
                  "pm.test('monto vigente = precio − 1000', () => pm.expect(d.monto).to.eql(pm.environment.get('monto_mesa_dec')));",
                  "pm.test('forma vigente con is_active', () => pm.expect(d.forma_pago).to.eql({ id: 'formapago-transferencia', nombre: 'Transferencia', is_active: true }));",
                  "pm.test('clases_abarcadas 2', () => pm.expect(d.clases_abarcadas).to.eql(2));",
                  "pm.test('comprobante de reemplazo', () => pm.expect(d.comprobante.numero).to.match(/^0001-\\d{8}$/));",
                  "pm.test('fecha YYYY-MM-DD', () => pm.expect(d.fecha_pago).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));"
                ]
              }
            }
          ]
        },

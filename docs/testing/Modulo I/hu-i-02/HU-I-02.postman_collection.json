{
  "info": {
    "name": "Noctium HU-I-02 Historial de pagos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar solo contra noctium_i02_pg (127.0.0.1:55434) con la app local en 3005. Cookies obtenidas por login; no contiene credenciales. Los requests GET no alteran datos."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3005"
    },
    {
      "key": "alumno_id",
      "value": ""
    },
    {
      "key": "alumno_inexistente_id",
      "value": "c123456789012345678901234"
    },
    {
      "key": "cookie_mesa",
      "value": ""
    },
    {
      "key": "cookie_gerente",
      "value": ""
    },
    {
      "key": "cookie_profesor",
      "value": ""
    },
    {
      "key": "cookie_alumno",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Mesa · historial 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_mesa}}"
          }
        ],
        "url": "{{base_url}}/api/pagos/historial?alumno_id={{alumno_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Sobre estándar\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Modo HISTORIAL y datos privados ausentes\", () => { pm.expect(body.data.modo).to.eql(\"HISTORIAL\"); pm.expect(body.data).not.to.have.property(\"saldo\"); pm.expect(body.data).not.to.have.property(\"caja\"); });"
            ]
          }
        }
      ]
    },
    {

    {
      "name": "Listado propio y filtros",
      "item": [
        {
          "name": "A · listado página 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.test(\"sobre { data, error }\", () => { pm.expect(b).to.have.property(\"data\"); pm.expect(b).to.have.property(\"error\"); });",
                  "pm.test(\"no-store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.match(/^no-store/));",
                  "const s = JSON.stringify(b); [\"registrado_por\",\"precio\",\"monto_original\",\"ajuste\",\"motivo\",\"caja\",\"operacion\",\"puede_corregir\"].forEach((k) => pm.test(\"sin \" + k, () => pm.expect(s).to.not.include(k)));",
                  "pm.test(\"10 filas y paginación de a 10\", () => { pm.expect(b.data.items.length).to.be.at.most(10); pm.expect(b.data.paginacion.por_pagina).to.eql(10); });",
                  "pm.test(\"claves exactas del ítem\", () => b.data.items.forEach((i) => pm.expect(Object.keys(i).sort()).to.eql([\"anulado\",\"clase\",\"comprobante\",\"fecha_pago\",\"forma_pago\",\"monto\",\"pago_id\"])));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{cookieAlumnoA}}"
              }
            ],
            "url": "{{baseUrl}}/api/mis-pagos"

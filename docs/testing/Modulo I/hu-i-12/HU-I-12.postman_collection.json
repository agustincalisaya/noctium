    {
      "name": "01 Mesa · GET caja propia — 200 sin totales",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/cajas/mia",
        "description": "Sesión: mesa (cookie de sesión de NextAuth en el Cookie Jar de Postman; no se exporta)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('sobre { data, error: null }', () => pm.expect(pm.response.json().error).to.eql(null));",
              "const c = pm.response.json().data.caja; if (c) { pm.test('sin totales (arqueo ciego)', () => pm.expect(JSON.stringify(c)).to.not.include('efectivo_esperado')); }"
            ]
          }
        }
      ]

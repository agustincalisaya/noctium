    {
      "key": "cookie_alumno",
      "value": ""
    },
    {
      "key": "alumno_registros",
      "value": ""
    },
    {
      "key": "alumno_inexistente",
      "value": "cknoexiste000000000000000"
    },
    {
      "key": "version",
      "value": "0"
    },
    {
      "key": "total_impacto",
      "value": "0"
    }
  ],

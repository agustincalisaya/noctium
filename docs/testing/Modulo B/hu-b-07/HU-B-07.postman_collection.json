      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope\", () => { pm.expect(body).to.have.property(\"data\"); pm.expect(body).to.have.property(\"error\"); });",
              "pm.test(\"Sin error\", () => pm.expect(body.error).to.eql(null));",
              "pm.test(\"Contrato\", () => { pm.expect(body.data).to.include.keys(\"alumno\", \"version\", \"total\", \"inscripciones_futuras\", \"motivo_obligatorio\"); });",
              "pm.test(\"Total coincide con la lista\", () => pm.expect(body.data.total).to.eql(body.data.inscripciones_futuras.length));",
              "pm.test(\"Motivo obligatorio con registros\", () => pm.expect(body.data.motivo_obligatorio).to.eql(true));",
              "body.data.inscripciones_futuras.forEach((i) => pm.test(`Inscripción ${i.inscripcion_id}`, () => { pm.expect(i).to.include.keys(\"inscripcion_id\", \"turno_id\", \"fecha\", \"hora_inicio\", \"hora_fin\", \"materia\", \"profesor\"); }));",
              "pm.collectionVariables.set(\"version\", String(body.data.version));",
              "pm.collectionVariables.set(\"total_impacto\", String(body.data.total));"
            ]
          }
        }
      ]

// ============================================================
// Noctium — Gestión Integral de un Centro de Atención Académica
// Sprint 1 (Incremento 1): Sesión, Alumnos, Profesores, Materias,
// Turnos iniciales, Aulas, Calendario básico.
//
// Convención de nombres: los atributos propios de cada entidad
// llevan el sufijo de la entidad (ej. nombreAlumno, dniProfesor,
// capacidadAula). Los id (PK) usan id<Entidad> y las claves
// foráneas usan <entidadReferenciada>Id, ya que ese patrón ya
// identifica la tabla referenciada y es el esperado por Prisma.
//
// IMPORTANTE: este schema modela ÚNICAMENTE el alcance de Sprint 1.
// No incluye: Pago, historial académico/exámenes, prioridad/forma
// de pago del turno, ni baja/reactivación de entidades (los flags
// activo/activa existen, pero ninguna HU de Sprint 1 los modifica)
// — todo eso corresponde a los DER de Sprint 2 / Sprint 3.
//
// Auditoría (creadoPorUsuarioId / modificadoPorUsuarioId): se modelan
// como campos escalares SIN @relation a Usuario. Una relación explícita
// obligaría a declarar en Usuario un campo inverso por cada una (con
// nombres de relación únicos), ensuciando el modelo; además la auditoría
// solo se escribe al alta/modificación y se lee por id, y sin FK borrar
// un Usuario no bloquea ni arrastra el historial. La integridad de esos
// ids la garantiza la aplicación.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum RolUsuario {
  ALUMNO
  PROFESOR
  GERENTE
  MESA_ENTRADA
}

// Catálogo de género (HU-B-01 / HU-D-01): sin texto libre.
enum Genero {
  MASCULINO
  FEMENINO
  OTRO
  PREFIERO_NO_INDICARLO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoTurno {
  PENDIENTE
  AGENDADO
}

// Eventos de seguridad a auditar (RNF-SEG-09): HU-A-01 c3/c5, HU-A-03 c3 y HU-B-08 c9.
// Los intentos de login fallidos tienen su propia tabla (IntentoLoginFallido);
// LOGIN_FALLIDO igual se registra acá para dejar un rastro unificado de eventos
// de seguridad, sin duplicar el conteo de rate limiting (que sigue viviendo
// exclusivamente en IntentoLoginFallido).
enum TipoEventoSeguridad {
  LOGIN_EXITOSO
  LOGIN_FALLIDO
  CUENTA_INACTIVA_RECHAZADA
  LOGOUT
  REGISTRO_CUENTA
  VERIFICACION_CODIGO_EXITOSA
  VERIFICACION_CODIGO_FALLIDA
}

// ------------------------------------------------------------
// Sesión / Autenticación
// (NextAuth con Credentials Provider, sin Prisma Adapter —
// la sesión se maneja por JWT; esta tabla es propia del dominio,
// no la impuesta por el adapter oficial de NextAuth)
// ------------------------------------------------------------

model Usuario {
  idUsuario        String     @id @default(cuid())
  emailUsuario     String     @unique
  passwordHashUsuario String
  rolUsuario       RolUsuario
  activoUsuario    Boolean    @default(true)
  createdAtUsuario DateTime   @default(now())
  updatedAtUsuario DateTime   @updatedAt

  alumno   Alumno?
  profesor Profesor?

  @@map("usuarios")
}

// Lista de revocación de JWT (HU-A-02 / HU-A-03, RNF-SEG-04):
// el jti se conserva hasta el vencimiento original del token.
model TokenRevocado {
  jti               String   @id
  usuarioId         String?
  expiraEn          DateTime
  creadoEnRevocado  DateTime @default(now())

  @@map("tokens_revocados")
}

// Matriz RBAC (HU-A-02, Regla N.° 10 de docs/RULES.md): rol -> acción
// habilitada. Se puebla de forma incremental, módulo por módulo, a medida
// que cada uno define sus propias acciones (ver nota de sincronización en
// spec_modulo_A.md) — HU-A-02 solo deja el mecanismo con "sesion:ping".
model RolPermiso {
  idPermiso       String     @id @default(cuid())
  rolPermiso      RolUsuario
  accionPermiso   String
  creadoEnPermiso DateTime   @default(now())

  @@unique([rolPermiso, accionPermiso])
  @@map("roles_permisos")
}

// Bloqueo por intentos fallidos (HU-A-01 c4): 5 intentos del mismo
// email desde la misma IP en 15 minutos. Nunca se guarda la contraseña.
model IntentoLoginFallido {
  idIntento       String   @id @default(cuid())
  emailIntento    String
  ipIntento       String
  creadoEnIntento DateTime @default(now())

  @@index([emailIntento, creadoEnIntento])
  @@map("intentos_login_fallidos")
}

// Límite de registros por IP y hora (HU-B-08 c9).
model IntentoRegistro {
  idIntentoRegistro       String   @id @default(cuid())
  ipIntentoRegistro       String
  creadoEnIntentoRegistro DateTime @default(now())

  @@index([ipIntentoRegistro, creadoEnIntentoRegistro])
  @@map("intentos_registro")
}

// Registro de eventos de seguridad (RNF-SEG-09): fecha, hora, usuario e IP.
// usuarioId es escalar sin relación (ver nota de auditoría en el encabezado).
model EventoSeguridad {
  idEvento       String              @id @default(cuid())
  tipoEvento     TipoEventoSeguridad
  usuarioId      String?
  emailEvento    String?
  ipEvento       String
  creadoEnEvento DateTime            @default(now())

  @@index([creadoEnEvento])
  @@map("eventos_seguridad")
}

// ------------------------------------------------------------
// Forma de pago — catálogo activable (HU-B-03)
// ------------------------------------------------------------

model FormaPago {
  idFormaPago     String  @id @default(cuid())
  nombreFormaPago String  @unique
  activaFormaPago Boolean @default(true)

  alumnos Alumno[]

  @@map("formas_pago")
}

// ------------------------------------------------------------
// Alumno (HU-B-01, HU-B-02, HU-B-03, HU-B-04, HU-B-06, HU-B-08)
// ------------------------------------------------------------

model Alumno {
  idAlumno     String  @id @default(cuid())
  // Opcional: HU-B-01 permite fichas sin cuenta; HU-B-08 vincula la cuenta después.
  usuarioId    String? @unique
  activoAlumno Boolean @default(true)

  // Datos de identidad (HU-B-01)
  nombreAlumno   String
  apellidoAlumno String
  dniAlumno      String @unique
  fechaNacimientoAlumno DateTime @db.Date
  generoAlumno   Genero?

  // Datos de contacto (HU-B-02) — al menos uno es obligatorio, validado en la app.
  telefonoAlumno  String?
  emailAlumno     String?
  direccionAlumno String?

  // Forma de pago preferida (HU-B-03) — null = "Sin preferencia".
  formaPagoPreferidaId String?

  // Aceptación de términos en el autorregistro (HU-B-08 c7)
  terminosAceptadosEn     DateTime?
  versionTerminosAceptada String?

  // Auditoría (escalares sin relación, ver encabezado). modificadoPor: HU-B-06.
  creadoPorUsuarioId     String?
  modificadoPorUsuarioId String?

  createdAtAlumno DateTime @default(now())
  updatedAtAlumno DateTime @updatedAt

  usuario             Usuario?             @relation(fields: [usuarioId], references: [idUsuario], onDelete: SetNull)
  formaPagoPreferida  FormaPago?           @relation(fields: [formaPagoPreferidaId], references: [idFormaPago])
  turnos              TurnoAlumno[]
  codigosVerificacion CodigoVerificacion[]

  @@map("alumnos")
}

// Código de verificación del autorregistro sobre una ficha existente
// sin cuenta (HU-B-08 c4). Solo se guarda el HMAC-SHA256 del código.
// invalidadoEn: marca de un solo uso / invalidado por un código nuevo; las
// filas se conservan para contar reenvíos por hora y la espera entre reenvíos.
model CodigoVerificacion {
  idCodigo    String    @id @default(cuid())
  alumnoId    String
  codigoHash  String
  expiraEn    DateTime
  intentos    Int       @default(0)
  invalidadoEn DateTime?
  creadoEn    DateTime  @default(now())

  alumno Alumno @relation(fields: [alumnoId], references: [idAlumno], onDelete: Cascade)

  @@map("codigos_verificacion")
}

// ------------------------------------------------------------
// Profesor (HU-D-01, HU-D-02, HU-D-03, HU-D-04, HU-D-05)
// ------------------------------------------------------------

model Profesor {
  idProfesor     String  @id @default(cuid())
  // Opcional: registrar la ficha NO crea una cuenta (HU-D-01 c5).
  usuarioId      String? @unique
  activoProfesor Boolean @default(true)

  // Datos de identidad (HU-D-01)
  nombreProfesor   String
  apellidoProfesor String
  dniProfesor      String @unique
  fechaNacimientoProfesor DateTime @db.Date
  generoProfesor   Genero?

  // Datos de contacto (HU-D-02) — al menos uno es obligatorio, validado en la app.
  telefonoProfesor  String?
  emailProfesor     String?
  direccionProfesor String?

  // Auditoría (escalares sin relación, ver encabezado). modificadoPor: HU-D-02.
  creadoPorUsuarioId     String?
  modificadoPorUsuarioId String?

  createdAtProfesor DateTime @default(now())
  updatedAtProfesor DateTime @updatedAt

  usuario  Usuario?          @relation(fields: [usuarioId], references: [idUsuario], onDelete: SetNull)
  materias ProfesorMateria[] // HU-D-03: materias/especialidades asociadas
  horarios HorarioProfesor[] // HU-D-04: horario de atención
  turnos   Turno[]

  @@map("profesores")
}

// Horario de atención del profesor (HU-D-04) — disponibilidad
// recurrente por día de semana, distinta de un Turno puntual.
model HorarioProfesor {
  idHorario       String    @id @default(cuid())
  profesorId      String
  diaSemanaHorario DiaSemana
  horaDesdeHorario DateTime  @db.Time
  horaHastaHorario DateTime  @db.Time

  // Auditoría (HU-D-04 c6: "registra fecha y usuario")
  createdAtHorario   DateTime @default(now())
  creadoPorUsuarioId String?

  profesor Profesor @relation(fields: [profesorId], references: [idProfesor], onDelete: Cascade)

  @@map("horarios_profesor")
}

// ------------------------------------------------------------
// Materia (HU-L-01, HU-L-02, HU-L-03)
// ------------------------------------------------------------

model Materia {
  idMateria    String  @id @default(cuid())
  nombreMateria String @unique
  // Comparación de unicidad case/acento-insensitiva (HU-L-01 criterio 3:
  // "Matemática" == "matematica"), vía normalizarTexto() — el @unique de
  // nombreMateria de arriba compara texto crudo, no alcanza para eso.
  nombreNormalizadaMateria String @unique
  codigoMateria String? @unique
  activaMateria Boolean @default(true)

  // Auditoría (escalar sin relación, ver encabezado)
  createdAtMateria   DateTime @default(now())
  creadoPorUsuarioId String?

  profesores ProfesorMateria[]
  turnos     Turno[]

  @@map("materias")
}

// Tabla intermedia N:M Profesor <-> Materia
model ProfesorMateria {
  profesorId String
  materiaId  String

  profesor Profesor @relation(fields: [profesorId], references: [idProfesor], onDelete: Cascade)
  materia  Materia  @relation(fields: [materiaId], references: [idMateria], onDelete: Cascade)

  @@id([profesorId, materiaId])
  @@map("profesor_materia")
}

// ------------------------------------------------------------
// Aula (HU-K-01, HU-K-02)
// ------------------------------------------------------------

model Aula {
  idAula       String @id @default(cuid())
  nombreAula   String @unique // nombre o número de aula
  // Comparación de unicidad case/acento-insensitiva (HU-K-01 criterio 2:
  // "Aula 1" == "aula 1"), vía normalizarTexto() — el @unique de nombreAula
  // de arriba compara texto crudo, no alcanza para eso.
  nombreNormalizadaAula String @unique
  capacidadAula Int
  activaAula   Boolean @default(true)

  // Auditoría (escalar sin relación, ver encabezado)
  createdAtAula      DateTime @default(now())
  creadoPorUsuarioId String?

  turnos Turno[]

  @@map("aulas")
}

// ------------------------------------------------------------
// Turno (HU-C-01, HU-C-03, HU-C-04, HU-C-15)
// Instancia puntual: fecha + hora fija, no una comisión recurrente.
// ------------------------------------------------------------

model Turno {
  idTurno       String        @id @default(cuid())
  fechaTurno    DateTime      @db.Date
  horaInicioTurno DateTime    @db.Time
  // Duración vigente al crear el turno (HU-C-03 c3: duración estándar del
  // centro). Se guarda en el turno para que cambiar el parámetro no altere
  // los turnos ya creados.
  duracionMinutosTurno Int
  estadoTurno   EstadoTurno   @default(PENDIENTE)

  materiaId  String
  profesorId String?
  aulaId     String?

  // Auditoría (escalar sin relación, ver encabezado)
  creadoPorUsuarioId String?

  createdAtTurno DateTime @default(now())
  updatedAtTurno DateTime @updatedAt

  materia  Materia       @relation(fields: [materiaId], references: [idMateria])
  profesor Profesor?     @relation(fields: [profesorId], references: [idProfesor])
  aula     Aula?         @relation(fields: [aulaId], references: [idAula])
  alumnos  TurnoAlumno[]

  @@map("turnos")
}

// Tabla intermedia N:M Turno <-> Alumno.
// Permite turnos grupales: los alumnos se inscriben de a uno
// hasta completar el cupo (validado en la app contra Aula.capacidadAula).
model TurnoAlumno {
  turnoId  String
  alumnoId String

  turno  Turno  @relation(fields: [turnoId], references: [idTurno], onDelete: Cascade)
  alumno Alumno @relation(fields: [alumnoId], references: [idAlumno], onDelete: Cascade)

  @@id([turnoId, alumnoId])
  @@map("turno_alumno")
}

// ------------------------------------------------------------
// Parámetros configurables del centro (clave/valor como texto)
// ------------------------------------------------------------

model ParametroSistema {
  clave String @id
  valor String

  @@map("parametros_sistema")
}

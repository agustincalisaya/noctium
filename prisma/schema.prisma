// ============================================================
// Noctium — Gestión Integral de un Centro de Atención Académica
// Sprint 1 (Incremento 1): Sesión, Alumnos, Profesores, Materias,
// Turnos iniciales, Aulas, Calendario básico.
//
// Convención de nombres: los atributos propios de cada entidad
// llevan el sufijo de la entidad (ej. nombreAlumno, dniProfesor,
// capacidadAula). Los id (PK) usan id<Entidad> y las claves
// foráneas usan <entidadReferenciada>Id, ya que ese patrón ya
// identifica la tabla referenciada y es el esperado por Prisma.
//
// Sprint 1 + extensión aditiva de Sprint 2 (estado CANCELADO, pagos con alumno,
// historial académico, prioridad, auditoría y versiones). Backlog v2 (28/09):
// HU-C-11 retirada, así que el turno NO tiene forma de pago.
//
// Auditoría (creadoPorUsuarioId / modificadoPorUsuarioId): se modelan
// como campos escalares SIN @relation a Usuario. Una relación explícita
// obligaría a declarar en Usuario un campo inverso por cada una (con
// nombres de relación únicos), ensuciando el modelo; además la auditoría
// solo se escribe al alta/modificación y se lee por id, y sin FK borrar
// un Usuario no bloquea ni arrastra el historial. La integridad de esos
// ids la garantiza la aplicación.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum RolUsuario {
  ALUMNO
  PROFESOR
  GERENTE
  MESA_ENTRADA
}

// Catálogo de género (HU-B-01 / HU-D-01): sin texto libre.
enum Genero {
  MASCULINO
  FEMENINO
  OTRO
  PREFIERO_NO_INDICARLO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

// spec_modulo_C.md Revisión 2: PENDIENTE → {DISPONIBLE ⇄ COMPLETO}.
enum EstadoTurno {
  PENDIENTE
  DISPONIBLE
  COMPLETO
  CANCELADO
}

enum PrioridadTurno {
  NORMAL
  ALTA
  URGENTE
}

// Eventos de seguridad a auditar (RNF-SEG-09): HU-A-01 c3/c5, HU-A-03 c3 y HU-B-08 c9.
// Los intentos de login fallidos tienen su propia tabla (IntentoLoginFallido);
// LOGIN_FALLIDO igual se registra acá para dejar un rastro unificado de eventos
// de seguridad, sin duplicar el conteo de rate limiting (que sigue viviendo
// exclusivamente en IntentoLoginFallido).
enum TipoEventoSeguridad {
  LOGIN_EXITOSO
  LOGIN_FALLIDO
  CUENTA_INACTIVA_RECHAZADA
  LOGOUT
  REGISTRO_CUENTA
  VERIFICACION_CODIGO_EXITOSA
  VERIFICACION_CODIGO_FALLIDA
  // HU-B-08: agregados al confirmar el mecanismo real de eventos de este
  // repo (EventoSeguridad, no un event bus) — REGISTRO_CUENTA y los dos
  // VERIFICACION_CODIGO_* ya existían reservados, sin uso, desde antes de
  // esta HU. Extensión aditiva, autorizada como parte del alcance mínimo de
  // Módulo A para esta HU — no se toca nada más de ese módulo.
  CODIGO_VERIFICACION_GENERADO
  AUTORREGISTRO_DERIVADO_MESA_ENTRADA
  // Sprint 3 (PR 0, spec_modulo_A.md §4 Revisión 3): cuentas de HU-A-06 y
  // recuperación de HU-A-05. Se agregan con ADD VALUE en su propia migración.
  CUENTA_CREADA
  PASSWORD_CAMBIADA
  RECUPERACION_SOLICITADA
  RECUPERACION_LIMITADA
  RECUPERACION_ENVIO_FALLIDO
  RECUPERACION_CONFIRMADA
}

// ------------------------------------------------------------
// Enums del Sprint 3 (PR 0)
// ------------------------------------------------------------

// Si la inscripción sigue en pie (convención 8 a, PR-0.md §2.1). Toda
// vigencia distinta de VIGENTE es terminal.
enum VigenciaInscripcion {
  VIGENTE
  CANCELADA_ALUMNO
  RESERVA_VENCIDA
  BAJA_ALUMNO
  QUITADA_CENTRO
}

// Estado de pago de la inscripción (solo tiene sentido si es VIGENTE; al
// finalizarla queda congelado con su último valor).
enum EstadoPagoInscripcion {
  RESERVADA
  PAGADA
  PAGO_SIN_REGISTRAR
}

// Actor de las columnas «…UsuarioId + actorTipo» (PR-0.md §2.1): USUARIO
// exige el usuario; PROCESO_AUTOMATICO lo exige null (CHECK en la migración).
enum ActorTipo {
  USUARIO
  PROCESO_AUTOMATICO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

// HU-E-09: null en ClaseDictadaAlumno = registrada sin control de asistencia.
enum EstadoAsistencia {
  PRESENTE
  AUSENTE
}

// Historial de bajas y reactivaciones (PR-0.md §2.13 y §2.14).
enum EntidadHistorialEstado {
  ALUMNO
  PROFESOR
  FICHA_MESA_ENTRADA
  FICHA_GERENTE
  FORMA_PAGO
}

enum AccionHistorialEstado {
  DESACTIVAR
  REACTIVAR
}

// ------------------------------------------------------------
// Sesión / Autenticación
// (NextAuth con Credentials Provider, sin Prisma Adapter —
// la sesión se maneja por JWT; esta tabla es propia del dominio,
// no la impuesta por el adapter oficial de NextAuth)
// ------------------------------------------------------------

model Usuario {
  idUsuario        String     @id @default(cuid())
  emailUsuario     String     @unique
  passwordHashUsuario String
  rolUsuario       RolUsuario
  activoUsuario    Boolean    @default(true)
  createdAtUsuario DateTime   @default(now())
  updatedAtUsuario DateTime   @updatedAt
  // HU-A-06 (spec_modulo_A.md §2.6.5): contraseña inicial pendiente de cambio.
  debeCambiarPasswordUsuario  Boolean   @default(false)
  // RNF-SEG-04: toda sesión con iat_sesion anterior se rechaza. Se guarda
  // truncado a segundos, igual que el claim iat_sesion.
  sesionesValidasDesdeUsuario DateTime?

  alumno   Alumno?
  profesor Profesor?
  fichaMesaEntrada   FichaMesaEntrada?
  fichaGerente       FichaGerente?
  tokensRecuperacion TokenRecuperacion[]
  cajas              Caja[]

  @@map("usuarios")
}

// Enlace de recuperación de contraseña (HU-A-05, spec_modulo_A.md §2.7.5).
// Solo se guarda el SHA-256 del valor enviado.
model TokenRecuperacion {
  idTokenRecuperacion   String    @id @default(cuid())
  usuarioId             String
  tokenHashRecuperacion String    @unique
  venceEnToken          DateTime
  // Usado, o invalidado por un enlace nuevo.
  consumidoEnToken      DateTime?
  creadoEnToken         DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario])

  @@index([usuarioId, consumidoEnToken])
  @@map("tokens_recuperacion")
}

// Tabla operativa del límite de solicitudes por email (HU-A-05), mismo patrón
// que IntentoLoginFallido: solo sirve para contar.
model SolicitudRecuperacion {
  idSolicitudRecuperacion String   @id @default(cuid())
  emailSolicitud          String
  ipSolicitud             String
  creadoEnSolicitud       DateTime @default(now())

  @@index([emailSolicitud, creadoEnSolicitud])
  @@map("solicitudes_recuperacion")
}

// Lista de revocación de JWT (HU-A-02 / HU-A-03, RNF-SEG-04):
// el jti se conserva hasta el vencimiento original del token.
model TokenRevocado {
  jti               String   @id
  usuarioId         String?
  expiraEn          DateTime
  creadoEnRevocado  DateTime @default(now())

  @@map("tokens_revocados")
}

// Matriz RBAC (HU-A-02, Regla N.° 10 de docs/RULES.md): rol -> acción
// habilitada. Se puebla de forma incremental, módulo por módulo, a medida
// que cada uno define sus propias acciones (ver nota de sincronización en
// spec_modulo_A.md) — HU-A-02 solo deja el mecanismo con "sesion:ping".
model RolPermiso {
  idPermiso       String     @id @default(cuid())
  rolPermiso      RolUsuario
  accionPermiso   String
  creadoEnPermiso DateTime   @default(now())

  @@unique([rolPermiso, accionPermiso])
  @@map("roles_permisos")
}

// Bloqueo por intentos fallidos (HU-A-01 c4): 5 intentos del mismo
// email desde la misma IP en 15 minutos. Nunca se guarda la contraseña.
model IntentoLoginFallido {
  idIntento       String   @id @default(cuid())
  emailIntento    String
  ipIntento       String
  creadoEnIntento DateTime @default(now())

  @@index([emailIntento, creadoEnIntento])
  @@map("intentos_login_fallidos")
}

// Límite de registros por IP y hora (HU-B-08 c9).
model IntentoRegistro {
  idIntentoRegistro       String   @id @default(cuid())
  ipIntentoRegistro       String
  creadoEnIntentoRegistro DateTime @default(now())

  @@index([ipIntentoRegistro, creadoEnIntentoRegistro])
  @@map("intentos_registro")
}

// Registro de eventos de seguridad (RNF-SEG-09): fecha, hora, usuario e IP.
// usuarioId es escalar sin relación (ver nota de auditoría en el encabezado).
model EventoSeguridad {
  idEvento       String              @id @default(cuid())
  tipoEvento     TipoEventoSeguridad
  usuarioId      String?
  emailEvento    String?
  ipEvento       String
  creadoEnEvento DateTime            @default(now())

  @@index([creadoEnEvento])
  @@map("eventos_seguridad")
}

// ------------------------------------------------------------
// Forma de pago — catálogo activable (HU-B-03)
// ------------------------------------------------------------

model FormaPago {
  idFormaPago     String  @id @default(cuid())
  nombreFormaPago String  @unique
  nombreNormalizadaFormaPago String @unique
  activaFormaPago Boolean @default(true)
  createdAtFormaPago DateTime @default(now())
  creadoPorUsuarioId String?
  // Arqueo de caja (HU-I-12): solo la forma «Efectivo» del catálogo
  // (formapago-efectivo) la tiene. Ninguna pantalla la edita.
  esEfectivo Boolean @default(false)

  alumnos Alumno[]
  pagos Pago[]
  operaciones OperacionPago[]
  correccionesOperacionAnterior CorreccionOperacion[] @relation("CorreccionOperacionFormaAnterior")
  correccionesOperacionNueva    CorreccionOperacion[] @relation("CorreccionOperacionFormaNueva")
  ajustesCaja AjusteCaja[]

  @@map("formas_pago")
}

// ------------------------------------------------------------
// Alumno (HU-B-01, HU-B-02, HU-B-03, HU-B-04, HU-B-06, HU-B-08)
// ------------------------------------------------------------

model Alumno {
  idAlumno     String  @id @default(cuid())
  // Opcional: HU-B-01 permite fichas sin cuenta; HU-B-08 vincula la cuenta después.
  usuarioId    String? @unique
  activoAlumno Boolean @default(true)

  // Datos de identidad (HU-B-01)
  nombreAlumno   String
  apellidoAlumno String
  // Orden case/acento-insensitivo del listado (HU-B-04, spec_modulo_B.md §2.4).
  // No @unique (a diferencia de nombreNormalizadaMateria): apellido/nombre no
  // son únicos entre alumnos.
  nombreNormalizadoAlumno   String
  apellidoNormalizadoAlumno String
  dniAlumno      String @unique
  fechaNacimientoAlumno DateTime @db.Date
  generoAlumno   Genero?

  // Datos de contacto (HU-B-02) — al menos uno es obligatorio, validado en la app.
  telefonoAlumno  String?
  emailAlumno     String?
  direccionAlumno String?

  // Forma de pago preferida (HU-B-03) — null = "Sin preferencia".
  formaPagoPreferidaId String?

  // Aceptación de términos en el autorregistro (HU-B-08 c7)
  terminosAceptadosEn     DateTime?
  versionTerminosAceptada String?

  // Auditoría (escalares sin relación, ver encabezado). modificadoPor: HU-B-06.
  creadoPorUsuarioId     String?
  modificadoPorUsuarioId String?

  // Concurrencia optimista (HU-B-06, RULES.md Regla N.° 7): condición del
  // updateMany en modificarAlumno(), incrementada en cada edición exitosa.
  version Int @default(0)

  createdAtAlumno DateTime @default(now())
  updatedAtAlumno DateTime @updatedAt

  usuario                  Usuario?                 @relation(fields: [usuarioId], references: [idUsuario], onDelete: SetNull)
  formaPagoPreferida       FormaPago?               @relation(fields: [formaPagoPreferidaId], references: [idFormaPago])
  turnos                   TurnoAlumno[]
  clasesDictadas           ClaseDictadaAlumno[]
  resultadosExamen         ResultadoExamen[]
  pagos                    Pago[]
  codigosVerificacion      CodigoVerificacion[]
  solicitudesAutorregistro SolicitudAutorregistro[]
  operacionesPago          OperacionPago[]
  correccionesAsistencia   CorreccionAsistenciaAlumno[]
  indicaciones             Indicacion[]

  @@map("alumnos")
}

// Código de verificación del autorregistro sobre una ficha existente
// sin cuenta (HU-B-08 c4). Solo se guarda el HMAC-SHA256 del código. Fila
// única por SolicitudAutorregistro (1:1) — el reenvío SOBRESCRIBE
// codigoHash/expiraEn de esta misma fila (resetea intentos a 0), nunca crea
// una fila nueva; invalidadoEn marca el consumo de un solo uso (confirmado,
// o reemplazado por una solicitud nueva del mismo alumno). Por eso esta
// tabla, sola, NO alcanza para contar reenvíos por hora ni la espera entre
// ellos (perdería el historial en cada sobrescritura) — eso lo resuelve
// ReenvioCodigo, una fila append-only por cada reenvío real.
model CodigoVerificacion {
  idCodigo    String    @id @default(cuid())
  alumnoId    String
  codigoHash  String
  expiraEn    DateTime
  intentos    Int       @default(0)
  invalidadoEn DateTime?
  creadoEn    DateTime  @default(now())

  alumno                 Alumno                  @relation(fields: [alumnoId], references: [idAlumno], onDelete: Cascade)
  solicitudAutorregistro SolicitudAutorregistro?
  reenvios               ReenvioCodigo[]

  @@map("codigos_verificacion")
}

// Historial append-only de reenvíos de código (HU-B-08 §4.4) — una fila por
// cada reenvío real. Separada de CodigoVerificacion a propósito (Adriel,
// 2026-09-24): esa tabla sobrescribe sus campos en cada reenvío, así que no
// puede sostener un conteo de ventana rodante ("máximo N por hora"). Mismo
// patrón ya usado en el repo para rate limiting (IntentoLoginFallido,
// IntentoRegistro): tabla de log dedicada, se cuenta con `count()` sobre
// creadoEn en la ventana de tiempo que corresponda.
model ReenvioCodigo {
  idReenvio String   @id @default(cuid())
  codigoId  String
  creadoEn  DateTime @default(now())

  codigo CodigoVerificacion @relation(fields: [codigoId], references: [idCodigo], onDelete: Cascade)

  @@index([codigoId, creadoEn])
  @@map("reenvios_codigo")
}

// Solicitud de autorregistro pendiente de confirmación (HU-B-08, rama b:
// ficha existente sin cuenta vinculada). Guarda el password_hash ya
// calculado hasta que el alumno confirma el código — modelo nuevo, separado
// a propósito de CodigoVerificacion (Adriel, 2026-09-24): esa tabla queda
// genérica y reutilizable para otros flujos de OTP futuros (ej. recuperación
// de contraseña) que no necesitan cargar un password pendiente.
//
// confirmadaEn (DateTime?, no un enum de estado): mismo patrón ya usado en
// el resto del schema para marcar un hecho consumado de una sola vez
// (terminosAceptadosEn, invalidadoEn) — "pendiente" es confirmadaEn null,
// "confirmada" es confirmadaEn seteada. "Vencida"/"sin intentos" no se
// duplica acá: se deriva enteramente de expiraEn/intentos/invalidadoEn de
// su CodigoVerificacion asociado (relación 1:1), sin otro campo de estado.
// El reenvío de código sobrescribe codigoHash/expiraEn de esa misma fila
// (spec_modulo_B.md §2.6, "el viejo deja de ser válido de inmediato") — no
// crea una CodigoVerificacion nueva, así que la relación 1:1 se mantiene
// estable durante toda la vida de la solicitud.
model SolicitudAutorregistro {
  idSolicitud  String    @id @default(cuid())
  alumnoId     String
  passwordHash String
  // Email de contacto vigente AL MOMENTO de generar el código (no el
  // tipeado en el formulario — mismo criterio que el resto del flujo).
  // Congelado acá a propósito: si Alumno.emailAlumno cambia entre que se
  // generó el código y que se confirma (HU-B-06 lo permite mientras
  // usuarioId siga null), la cuenta debe crearse con el email al que
  // efectivamente se mandó y confirmó el código, no con uno distinto leído
  // fresco en el momento de confirmar.
  emailDestino String
  codigoId     String    @unique
  confirmadaEn DateTime?
  creadaEn     DateTime  @default(now())

  alumno Alumno             @relation(fields: [alumnoId], references: [idAlumno], onDelete: Cascade)
  codigo CodigoVerificacion @relation(fields: [codigoId], references: [idCodigo], onDelete: Cascade)

  @@map("solicitudes_autorregistro")
}

// ------------------------------------------------------------
// Profesor (HU-D-01, HU-D-02, HU-D-03, HU-D-04, HU-D-05)
// ------------------------------------------------------------

model Profesor {
  idProfesor     String  @id @default(cuid())
  // Opcional: registrar la ficha NO crea una cuenta (HU-D-01 c5).
  usuarioId      String? @unique
  activoProfesor Boolean @default(true)

  // Datos de identidad (HU-D-01)
  nombreProfesor   String
  apellidoProfesor String
  // Orden case/acento-insensitivo del listado (HU-D-05, spec_modulo_D.md
  // §2.5), mismo criterio que nombreNormalizadoAlumno/apellidoNormalizadoAlumno
  // (HU-B-04): se guardan con normalizarTexto() al dar de alta.
  nombreNormalizadoProfesor   String
  apellidoNormalizadoProfesor String
  dniProfesor      String @unique
  fechaNacimientoProfesor DateTime @db.Date
  generoProfesor   Genero?

  // Datos de contacto (HU-D-02) — al menos uno es obligatorio, validado en la app.
  telefonoProfesor  String?
  emailProfesor     String?
  direccionProfesor String?

  // Auditoría (escalares sin relación, ver encabezado). modificadoPor: HU-D-02.
  creadoPorUsuarioId     String?
  modificadoPorUsuarioId String?

  createdAtProfesor DateTime @default(now())
  updatedAtProfesor DateTime @updatedAt
  version Int @default(0)

  usuario  Usuario?          @relation(fields: [usuarioId], references: [idUsuario], onDelete: SetNull)
  materias ProfesorMateria[] // HU-D-03: materias/especialidades asociadas
  horarios HorarioProfesor[] // HU-D-04: horario de atención
  turnos   Turno[]
  clasesDictadas ClaseDictada[]

  // Orden del listado (HU-D-05): apellido, nombre, DNI.
  @@index([apellidoNormalizadoProfesor, nombreNormalizadoProfesor, dniProfesor], map: "profesores_orden_listado_idx")
  @@map("profesores")
}

// Horario de atención del profesor (HU-D-04) — disponibilidad
// recurrente por día de semana, distinta de un Turno puntual.
model HorarioProfesor {
  idHorario       String    @id @default(cuid())
  profesorId      String
  diaSemanaHorario DiaSemana
  horaDesdeHorario DateTime  @db.Time
  horaHastaHorario DateTime  @db.Time

  // Auditoría (HU-D-04 c6: "registra fecha y usuario")
  createdAtHorario   DateTime @default(now())
  creadoPorUsuarioId String?

  profesor Profesor @relation(fields: [profesorId], references: [idProfesor], onDelete: Cascade)

  @@map("horarios_profesor")
}

// ------------------------------------------------------------
// Materia (HU-L-01, HU-L-02, HU-L-03)
// ------------------------------------------------------------

model Materia {
  idMateria    String  @id @default(cuid())
  nombreMateria String @unique
  // Comparación de unicidad case/acento-insensitiva (HU-L-01 criterio 3:
  // "Matemática" == "matematica"), vía normalizarTexto() — el @unique de
  // nombreMateria de arriba compara texto crudo, no alcanza para eso.
  nombreNormalizadaMateria String @unique
  codigoMateria String? @unique
  activaMateria Boolean @default(true)

  // Auditoría (escalar sin relación, ver encabezado)
  createdAtMateria   DateTime @default(now())
  updatedAtMateria   DateTime @default(now()) @updatedAt
  creadoPorUsuarioId String?
  modificadoPorUsuarioId String?
  version Int @default(0)
  // Tarifa por hora en pesos (HU-L-06). Admite null = «sin tarifa»: el alta
  // de materia de Sprint 1 no la recibe (PR-0.md §2.4, spec_modulo_L.md P-L1).
  // CHECK > 0 en la migración. C e I la leen con obtenerTarifasPorIds.
  tarifaHoraMateria Int?

  profesores ProfesorMateria[]
  turnos     Turno[]
  clasesDictadas ClaseDictada[]
  resultadosExamen ResultadoExamen[]
  historialTarifas HistorialTarifa[]
  indicaciones     Indicacion[]

  @@map("materias")
}

// Cambios de tarifa (HU-L-06 individual, HU-L-07 masivo). Se inserta en la
// misma transacción que el cambio (PR-0.md §2.4, excepción documentada).
model HistorialTarifa {
  idHistorialTarifa String   @id @default(cuid())
  materiaId         String
  // null: primera definición de la tarifa de una materia sin tarifa.
  tarifaAnterior    Int?
  tarifaNueva       Int
  usuarioId         String
  fecha             DateTime
  masivo            Boolean  @default(false)

  materia Materia @relation(fields: [materiaId], references: [idMateria])

  @@index([materiaId, fecha])
  @@map("historial_tarifas")
}

// Tabla intermedia N:M Profesor <-> Materia
model ProfesorMateria {
  profesorId String
  materiaId  String

  // Auditoría (Regla 2, opción a) — HU-D-03. Escalar sin relación, igual que
  // Profesor/Materia. Nullable: las filas del seed y las preexistentes no
  // tienen autor.
  createdAtProfesorMateria DateTime @default(now())
  creadoPorUsuarioId       String?

  profesor Profesor @relation(fields: [profesorId], references: [idProfesor], onDelete: Cascade)
  materia  Materia  @relation(fields: [materiaId], references: [idMateria], onDelete: Cascade)

  @@id([profesorId, materiaId])
  @@map("profesor_materia")
}

// ------------------------------------------------------------
// Aula (HU-K-01, HU-K-02)
// ------------------------------------------------------------

model Aula {
  idAula       String @id @default(cuid())
  // varchar(30) con collation `natural_es` (HU-K-02, spec_modulo_K.md §2.2):
  // orden natural ("Aula 2" antes que "Aula 10") a nivel de columna, vía
  // migración manual — Prisma no modela COLLATE en el DSL, así que este
  // atributo no aparece acá; @db.VarChar(30) sí, para no perder sincronía
  // de longitud con la migración.
  nombreAula   String @unique @db.VarChar(30) // nombre o número de aula
  // Comparación de unicidad case/acento-insensitiva (HU-K-01 criterio 2:
  // "Aula 1" == "aula 1"), vía normalizarTexto() — el @unique de nombreAula
  // de arriba compara texto crudo, no alcanza para eso.
  nombreNormalizadaAula String @unique
  capacidadAula Int
  activaAula   Boolean @default(true)

  // Auditoría (escalar sin relación, ver encabezado)
  createdAtAula      DateTime @default(now())
  updatedAtAula      DateTime @default(now()) @updatedAt
  creadoPorUsuarioId String?
  modificadoPorUsuarioId String?
  version Int @default(0)

  turnos Turno[]

  @@map("aulas")
}

// ------------------------------------------------------------
// Turno (HU-C-01, HU-C-03, HU-C-04, HU-C-15)
// Instancia puntual: fecha + hora fija, no una comisión recurrente.
// ------------------------------------------------------------

model Turno {
  idTurno       String        @id @default(cuid())
  fechaTurno    DateTime      @db.Date
  horaInicioTurno DateTime    @db.Time
  // Duración elegida al configurar el turno, uno de
  // DURACIONES_PERMITIDAS_TURNO_MIN (spec_modulo_C.md Revisión 4). La hora
  // de fin no se guarda: se deriva como horaInicioTurno + duracionMinutosTurno.
  duracionMinutosTurno Int
  // Cantidad máxima de alumnos inscriptos. NULL hasta asignar aula: se fija
  // con la capacidad del aula elegida (spec_modulo_C.md Revisión 3, §2.3).
  cupoMaximoTurno Int?
  estadoTurno   EstadoTurno   @default(PENDIENTE)
  prioridadTurno PrioridadTurno @default(NORMAL)

  materiaId  String
  profesorId String?
  aulaId     String?

  // Auditoría (escalar sin relación, ver encabezado)
  creadoPorUsuarioId String?
  modificadoPorUsuarioId String?

  createdAtTurno DateTime @default(now())
  updatedAtTurno DateTime @updatedAt

  materia  Materia       @relation(fields: [materiaId], references: [idMateria])
  profesor Profesor?     @relation(fields: [profesorId], references: [idProfesor])
  aula     Aula?         @relation(fields: [aulaId], references: [idAula])
  alumnos  TurnoAlumno[]
  reservas ReservaTurno[]
  pagos Pago[]
  // 1:N desde el Sprint 3 (PR-0.md §2.0 y §2.8): la unicidad «una clase
  // dictada no anulada por turno» es un índice único parcial de la migración.
  clasesDictadas ClaseDictada[]

  @@map("turnos")
}

// Inscripción de un alumno en un turno (spec_modulo_C.md Revisión 6, §2.16).
// Mismo modelo y misma tabla de Sprint 1 y 2, extendidos (PR-0.md §2.0): id
// propio y baja lógica por vigencia, así un alumno puede tener en la misma
// clase inscripciones finalizadas y una vigente. SQL manual de la migración:
//  - índice único parcial: una sola inscripción VIGENTE por (alumno, turno);
//  - CHECK de actor, de vigencia/finalización, de estado de pago/vencimiento
//    y de precio > 0;
//  - el trigger turno_alumno_sincronizar_reserva proyecta solo las VIGENTE.
// Toda escritura pasa por el servicio de inscripción (PR-0.md §2.13).
model TurnoAlumno {
  idInscripcion String @id @default(cuid())
  turnoId  String
  alumnoId String

  vigencia              VigenciaInscripcion   @default(VIGENTE)
  estadoPago            EstadoPagoInscripcion
  // Fechas de dominio: se guardan con ahora(), sin @default(now()) (PR-0.md §2.2).
  reservadaEl           DateTime
  // Momento desde el que corre el plazo vigente (se reinicia al reabrir por anulación).
  inicioPlazo           DateTime?
  // inicioPlazo + plazo aplicado, sin el tope del inicio de la clase.
  venceBaseEl           DateTime?
  // min(venceBaseEl, inicio de la clase). null salvo RESERVADA.
  venceEl               DateTime?
  // Entero en pesos, congelado al crear (precioClase).
  precio                Int
  reabiertaPorAnulacion Boolean               @default(false)

  // Cambio de vigencia: fecha y actor (usuario o «Proceso automático»).
  finalizadaEl           DateTime?
  finalizadaPorUsuarioId String?
  finalizadaPorActorTipo ActorTipo?

  // Auditoría de la fila (Regla N.° 2, opción a).
  creadoPorUsuarioId   String?
  createdAtInscripcion DateTime @default(now())

  turno  Turno  @relation(fields: [turnoId], references: [idTurno], onDelete: Cascade)
  alumno Alumno @relation(fields: [alumnoId], references: [idAlumno], onDelete: Cascade)
  pagos     Pago[]
  historial HistorialInscripcion[]

  @@index([turnoId, vigencia])
  @@index([alumnoId, vigencia])
  @@map("turno_alumno")
}

// Transiciones de la inscripción (Regla N.° 2): se escribe después del commit
// (despuesDelCommit, PR-0.md §2.10 y §2.16). El id se genera antes del commit
// para que el reintento sea idempotente.
model HistorialInscripcion {
  idHistorialInscripcion String                 @id @default(cuid())
  inscripcionId          String
  // null en la creación de la inscripción.
  vigenciaAnterior       VigenciaInscripcion?
  vigenciaNueva          VigenciaInscripcion
  estadoPagoAnterior     EstadoPagoInscripcion?
  estadoPagoNuevo        EstadoPagoInscripcion
  actorTipo              ActorTipo
  usuarioId              String?
  fecha                  DateTime

  inscripcion TurnoAlumno @relation(fields: [inscripcionId], references: [idInscripcion], onDelete: Cascade)

  @@index([inscripcionId, fecha])
  @@map("historial_inscripciones")
}

// Pago de una clase (uno por inscripción y operación). Conserva todas sus
// columnas de Sprint 2 como valores ORIGINALES e inmutables (PR-0.md §2.3,
// spec_modulo_I.md T6): el valor vigente de monto, forma y fecha sale de las
// correcciones. Se escribe solo con registrarOperacion.
model Pago {
  idPago String @id @default(cuid())
  turnoId String
  alumnoId String
  montoPago Decimal @db.Decimal(11, 2)
  formaPagoId String
  fechaPago DateTime @db.Date
  createdAtPago DateTime @default(now())
  creadoPorUsuarioId String?
  // Sprint 3
  operacionId          String
  inscripcionId        String
  // Precio de la clase (el de la inscripción), entero en pesos.
  precio               Int
  // Cuando montoPago difiere de precio. Admite vacío por el modo compatSprint2.
  motivoAjuste         String?          @db.VarChar(300)
  ajustadoPorUsuarioId String?
  turno Turno @relation(fields: [turnoId], references: [idTurno])
  alumno Alumno @relation(fields: [alumnoId], references: [idAlumno])
  formaPago FormaPago @relation(fields: [formaPagoId], references: [idFormaPago])
  operacion            OperacionPago    @relation(fields: [operacionId], references: [idOperacionPago])
  inscripcion          TurnoAlumno      @relation(fields: [inscripcionId], references: [idInscripcion])
  correcciones         CorreccionPago[]
  anulacion            AnulacionPago?
  ajustesCaja          AjusteCaja[]

  @@index([turnoId, createdAtPago])
  @@index([alumnoId, createdAtPago])
  @@index([inscripcionId])
  @@index([operacionId])
  @@map("pagos")
}

// Un cobro hecho en el mostrador (HU-I-10). Guarda los mismos valores
// originales de forma, fecha y usuario que cada Pago (base de las
// CorreccionOperacion). El total no se guarda.
model OperacionPago {
  idOperacionPago    String   @id @default(cuid())
  alumnoId           String
  formaPagoId        String
  fechaPago          DateTime @db.Date
  creadoPorUsuarioId String
  registradaEl       DateTime
  cajaId             String

  alumno       Alumno                @relation(fields: [alumnoId], references: [idAlumno])
  formaPago    FormaPago             @relation(fields: [formaPagoId], references: [idFormaPago])
  caja         Caja                  @relation(fields: [cajaId], references: [idCaja])
  pagos        Pago[]
  comprobantes Comprobante[]
  correcciones CorreccionOperacion[]

  @@index([alumnoId, fechaPago])
  @@index([cajaId])
  @@map("operaciones_pago")
}

// Cambio de monto de un pago (Regla N.° 8: registro nuevo).
model CorreccionPago {
  idCorreccionPago        String   @id @default(cuid())
  pagoId                  String
  montoAnterior           Decimal  @db.Decimal(11, 2)
  montoNuevo              Decimal  @db.Decimal(11, 2)
  motivo                  String   @db.VarChar(300)
  creadoPorUsuarioId      String
  createdAtCorreccionPago DateTime @default(now())

  pago        Pago         @relation(fields: [pagoId], references: [idPago])
  ajustesCaja AjusteCaja[]

  @@index([pagoId, createdAtCorreccionPago])
  @@map("correcciones_pago")
}

// Anulación de un pago (Regla N.° 8). Una por pago. Actor con CHECK.
model AnulacionPago {
  idAnulacionPago        String    @id @default(cuid())
  pagoId                 String    @unique
  motivo                 String    @db.VarChar(300)
  actorTipo              ActorTipo @default(USUARIO)
  creadoPorUsuarioId     String?
  createdAtAnulacionPago DateTime  @default(now())

  pago        Pago         @relation(fields: [pagoId], references: [idPago])
  ajustesCaja AjusteCaja[]

  @@map("anulaciones_pago")
}

// Cambio de forma O de fecha de pago de una operación (una fila por campo
// que cambia; CHECK: exactamente uno de los dos pares). Alcanza a todos los
// pagos de la operación.
model CorreccionOperacion {
  idCorreccionOperacion        String    @id @default(cuid())
  operacionId                  String
  formaPagoAnteriorId          String?
  formaPagoNuevaId             String?
  fechaPagoAnterior            DateTime? @db.Date
  fechaPagoNueva               DateTime? @db.Date
  motivo                       String    @db.VarChar(300)
  creadoPorUsuarioId           String
  createdAtCorreccionOperacion DateTime  @default(now())

  operacion         OperacionPago @relation(fields: [operacionId], references: [idOperacionPago])
  formaPagoAnterior FormaPago?    @relation("CorreccionOperacionFormaAnterior", fields: [formaPagoAnteriorId], references: [idFormaPago], onDelete: Restrict)
  formaPagoNueva    FormaPago?    @relation("CorreccionOperacionFormaNueva", fields: [formaPagoNuevaId], references: [idFormaPago], onDelete: Restrict)
  ajustesCaja       AjusteCaja[]

  @@index([operacionId, createdAtCorreccionOperacion])
  @@map("correcciones_operacion")
}

// Comprobante interno de una operación (HU-I-11). `numero` sale de la
// secuencia comprobante_numero_seq (migración), tomada en la transacción del
// pago; formato visible «0001-» + 8 dígitos. `datos` es la copia fija (JSON)
// de todo lo que muestra. Las marcas «ANULADO» y «Reemplazado por» no se
// guardan: se derivan.
model Comprobante {
  idComprobante String   @id @default(cuid())
  numero        Int      @unique
  operacionId   String
  datos         Json
  emitidoEl     DateTime
  reemplazaAId  String?  @unique

  operacion      OperacionPago @relation(fields: [operacionId], references: [idOperacionPago])
  reemplazaA     Comprobante?  @relation("ReemplazoComprobante", fields: [reemplazaAId], references: [idComprobante], onDelete: Restrict)
  reemplazadoPor Comprobante?  @relation("ReemplazoComprobante")

  @@index([operacionId])
  @@map("comprobantes")
}

// Caja de un integrante de mesa de entrada (HU-I-12). Índice único parcial de
// la migración: como máximo una caja ABIERTA por integrante. Después del
// cierre es inmutable (los cambios van como AjusteCaja en una caja abierta).
model Caja {
  idCaja              String     @id @default(cuid())
  // Integrante dueño de la caja.
  usuarioId           String
  estado              EstadoCaja @default(ABIERTA)
  abiertaEl           DateTime
  fondoInicial        Decimal    @db.Decimal(11, 2)
  // Se guarda al declararlo (antes del cierre), una sola vez.
  efectivoDeclarado   Decimal?   @db.Decimal(11, 2)
  cerradaEl           DateTime?
  // El integrante, o el gerente en el cierre por ausencia.
  cerradaPorUsuarioId String?
  cerradaPorActorTipo ActorTipo?
  porAusencia         Boolean    @default(false)
  efectivoEsperado    Decimal?   @db.Decimal(11, 2)
  // Con signo: declarado − esperado.
  diferencia          Decimal?   @db.Decimal(11, 2)
  motivo              String?    @db.VarChar(300)
  // Resumen fijo del cierre (no se recalcula).
  resumen             Json?

  usuario     Usuario          @relation(fields: [usuarioId], references: [idUsuario])
  operaciones OperacionPago[]
  movimientos MovimientoCaja[]
  ajustes     AjusteCaja[]

  @@index([usuarioId, estado])
  @@map("cajas")
}

// Ingreso o egreso manual de efectivo (HU-I-12). No se edita.
model MovimientoCaja {
  idMovimientoCaja        String             @id @default(cuid())
  cajaId                  String
  tipo                    TipoMovimientoCaja
  monto                   Decimal            @db.Decimal(11, 2)
  concepto                String             @db.VarChar(200)
  creadoPorUsuarioId      String
  createdAtMovimientoCaja DateTime           @default(now())

  caja      Caja                 @relation(fields: [cajaId], references: [idCaja])
  anulacion AnulacionMovimiento?

  @@index([cajaId, createdAtMovimientoCaja])
  @@map("movimientos_caja")
}

model AnulacionMovimiento {
  idAnulacionMovimiento        String    @id @default(cuid())
  movimientoId                 String    @unique
  motivo                       String    @db.VarChar(300)
  actorTipo                    ActorTipo @default(USUARIO)
  creadoPorUsuarioId           String?
  createdAtAnulacionMovimiento DateTime  @default(now())

  movimiento MovimientoCaja @relation(fields: [movimientoId], references: [idMovimientoCaja])

  @@map("anulaciones_movimiento")
}

// Dinero que se mueve al corregir o anular un pago de una caja CERRADA: se
// registra en una caja abierta (cajaId). Exactamente un origen (CHECK). El
// cambio de forma de pago genera un par (uno por forma, con signo opuesto).
model AjusteCaja {
  idAjusteCaja          String   @id @default(cuid())
  cajaId                String
  pagoId                String
  correccionPagoId      String?
  correccionOperacionId String?
  anulacionPagoId       String?
  formaPagoId           String
  // Con signo, distinto de 0.
  monto                 Decimal  @db.Decimal(11, 2)
  creadoPorUsuarioId    String
  createdAtAjusteCaja   DateTime @default(now())

  caja                Caja                 @relation(fields: [cajaId], references: [idCaja])
  pago                Pago                 @relation(fields: [pagoId], references: [idPago])
  correccionPago      CorreccionPago?      @relation(fields: [correccionPagoId], references: [idCorreccionPago], onDelete: Restrict)
  correccionOperacion CorreccionOperacion? @relation(fields: [correccionOperacionId], references: [idCorreccionOperacion], onDelete: Restrict)
  anulacionPago       AnulacionPago?       @relation(fields: [anulacionPagoId], references: [idAnulacionPago], onDelete: Restrict)
  formaPago           FormaPago            @relation(fields: [formaPagoId], references: [idFormaPago])

  @@index([cajaId, createdAtAjusteCaja])
  @@index([pagoId])
  @@map("ajustes_caja")
}

// Registro de clase dictada (HU-E-01). Desde el Sprint 3 (spec_modulo_E.md
// §2.5.1): la unicidad es el índice parcial «una no anulada por turno»
// (clases_dictadas_turno_no_anulada_key) y la marca de anulación se escribe
// una sola vez (excepción documentada a la Regla N.° 8).
model ClaseDictada {
  idClaseDictada String @id @default(cuid())
  turnoId               String
  fechaClaseDictada DateTime @db.Date
  materiaId String
  profesorId String
  createdAtClaseDictada DateTime @default(now())
  creadoPorUsuarioId String?
  // Sprint 3: false con el flujo de HU-E-01 (estados null), true con HU-E-09.
  conControlAsistencia  Boolean                @default(false)
  anuladaEl             DateTime?
  anuladaPorUsuarioId   String?
  motivoAnulacion       String?                @db.VarChar(300)
  turno Turno @relation(fields: [turnoId], references: [idTurno])
  materia Materia @relation(fields: [materiaId], references: [idMateria])
  profesor Profesor @relation(fields: [profesorId], references: [idProfesor])
  alumnos ClaseDictadaAlumno[]
  correcciones          CorreccionAsistencia[]
  observacion           ObservacionClase?
  indicaciones          Indicacion[]

  @@index([turnoId])
  @@index([profesorId, materiaId])
  @@map("clases_dictadas")
}

model ClaseDictadaAlumno {
  claseDictadaId String
  alumnoId String
  // HU-E-09: null = registrada sin control de asistencia.
  estadoAsistencia EstadoAsistencia?
  clase ClaseDictada @relation(fields: [claseDictadaId], references: [idClaseDictada])
  alumno Alumno @relation(fields: [alumnoId], references: [idAlumno])

  @@id([claseDictadaId, alumnoId])
  @@index([alumnoId])
  @@map("clases_dictadas_alumnos")
}

// Corrección de asistencia (HU-E-11): registro nuevo con sus propios estados
// y su propia marca de control (Regla N.° 8).
model CorreccionAsistencia {
  idCorreccionAsistencia String   @id @default(cuid())
  claseDictadaId         String
  motivo                 String   @db.VarChar(300)
  conControlAsistencia   Boolean  @default(true)
  createdAtCorreccion    DateTime @default(now())
  creadoPorUsuarioId     String?

  clase   ClaseDictada                 @relation(fields: [claseDictadaId], references: [idClaseDictada])
  alumnos CorreccionAsistenciaAlumno[]

  @@index([claseDictadaId, createdAtCorreccion])
  @@map("correcciones_asistencia")
}

model CorreccionAsistenciaAlumno {
  correccionId   String
  alumnoId       String
  // Valor vigente antes de la corrección (null si la clase no tenía control).
  estadoAnterior EstadoAsistencia?
  estadoNuevo    EstadoAsistencia

  correccion CorreccionAsistencia @relation(fields: [correccionId], references: [idCorreccionAsistencia])
  alumno     Alumno               @relation(fields: [alumnoId], references: [idAlumno])

  @@id([correccionId, alumnoId])
  @@index([alumnoId])
  @@map("correcciones_asistencia_alumnos")
}

// Observaciones de la clase (HU-E-07): a lo sumo una por registro de clase dictada.
model ObservacionClase {
  idObservacionClase    String   @id @default(cuid())
  claseDictadaId        String   @unique
  temasVistos           String   @db.VarChar(1000)
  observacionesInternas String?  @db.VarChar(1000)
  createdAtObservacion  DateTime @default(now())
  creadoPorUsuarioId    String?

  clase ClaseDictada @relation(fields: [claseDictadaId], references: [idClaseDictada])

  @@map("observaciones_clase")
}

// Indicación académica (HU-E-04). La clase dictada es opcional y se conserva
// aunque se anule (se oculta al leer).
model Indicacion {
  idIndicacion        String   @id @default(cuid())
  alumnoId            String
  materiaId           String
  claseDictadaId      String?
  texto               String   @db.VarChar(1000)
  createdAtIndicacion DateTime @default(now())
  creadoPorUsuarioId  String?

  alumno  Alumno        @relation(fields: [alumnoId], references: [idAlumno])
  materia Materia       @relation(fields: [materiaId], references: [idMateria])
  clase   ClaseDictada? @relation(fields: [claseDictadaId], references: [idClaseDictada], onDelete: Restrict)

  @@index([alumnoId, materiaId, createdAtIndicacion])
  @@map("indicaciones")
}

model ResultadoExamen {
  idResultadoExamen String @id @default(cuid())
  alumnoId String
  materiaId String
  fechaExamen DateTime @db.Date
  notaExamen Decimal @db.Decimal(4, 1)
  observaciones String? @db.Text
  createdAtResultadoExamen DateTime @default(now())
  creadoPorUsuarioId String?
  alumno Alumno @relation(fields: [alumnoId], references: [idAlumno])
  materia Materia @relation(fields: [materiaId], references: [idMateria])
  correcciones             CorreccionResultadoExamen[]
  anulacion                AnulacionResultadoExamen?

  @@index([alumnoId, fechaExamen])
  @@map("resultados_examen")
}

// HU-E-10: el ResultadoExamen original no se toca (Regla N.° 8).
model CorreccionResultadoExamen {
  idCorreccionResultado String   @id @default(cuid())
  resultadoExamenId     String
  fechaAnterior         DateTime @db.Date
  notaAnterior          Decimal  @db.Decimal(4, 1)
  fechaNueva            DateTime @db.Date
  notaNueva             Decimal  @db.Decimal(4, 1)
  motivo                String   @db.VarChar(300)
  createdAtCorreccion   DateTime @default(now())
  creadoPorUsuarioId    String?

  resultadoExamen ResultadoExamen @relation(fields: [resultadoExamenId], references: [idResultadoExamen])

  @@index([resultadoExamenId, createdAtCorreccion])
  @@map("correcciones_resultado_examen")
}

model AnulacionResultadoExamen {
  idAnulacionResultado String   @id @default(cuid())
  resultadoExamenId    String   @unique
  motivo               String   @db.VarChar(300)
  createdAtAnulacion   DateTime @default(now())
  creadoPorUsuarioId   String?

  resultadoExamen ResultadoExamen @relation(fields: [resultadoExamenId], references: [idResultadoExamen])

  @@map("anulaciones_resultado_examen")
}

// Proyección técnica mantenida por triggers PostgreSQL para impedir
// superposiciones entre turnos confirmados. No es una entidad de dominio.
model ReservaTurno {
  turnoId String
  tipoRecurso String
  recursoId String
  inicioReserva DateTime @db.Timestamp(6)
  finReserva DateTime @db.Timestamp(6)

  turno Turno @relation(fields: [turnoId], references: [idTurno], onDelete: Cascade)

  @@id([turnoId, tipoRecurso, recursoId])
  @@map("reservas_turno")
}

// Eventos de configuración del turno: escritura posterior al commit de negocio.
model EventoTurno {
  idEvento       String   @id @default(cuid())
  tipoEvento     String
  turnoId        String
  usuarioId      String
  payloadEvento  Json
  creadoEnEvento DateTime @default(now())

  @@index([turnoId, creadoEnEvento])
  @@map("eventos_turno")
}

// ------------------------------------------------------------
// Parámetros configurables del centro (clave/valor como texto)
// ------------------------------------------------------------

model ParametroSistema {
  clave String @id
  valor String

  @@map("parametros_sistema")
}

// Cambios de parámetros del centro (HU-N-01, Regla N.° 2 opción b): se
// escribe después del commit.
model HistorialParametro {
  idHistorialParametro String   @id @default(cuid())
  clave                String
  valorAnterior        String
  valorNuevo           String
  usuarioId            String
  fecha                DateTime

  @@index([fecha])
  @@index([usuarioId])
  @@map("historial_parametros")
}

// ------------------------------------------------------------
// Historial de bajas y reactivaciones (PR-0.md §2.13 y §2.14):
// registrarCambioEstado / listarHistorialEstados. Se escribe después del
// commit, con reintento; el id se genera antes del commit (idempotencia).
// ------------------------------------------------------------

model HistorialEstado {
  idHistorialEstado String                 @id @default(cuid())
  entidad           EntidadHistorialEstado
  entidadId         String
  accion            AccionHistorialEstado
  motivo            String?                @db.VarChar(300)
  actorTipo         ActorTipo
  usuarioId         String?
  fecha             DateTime

  @@index([entidad, entidadId, fecha])
  @@index([usuarioId])
  @@map("historial_estados")
}

// ------------------------------------------------------------
// Fichas del personal (HU-F y HU-G, spec_modulo_F.md §1 y spec_modulo_G.md):
// la ficha y la cuenta son una unidad; el email de la ficha es el de la
// cuenta. DNI único por tipo de ficha (activas e inactivas).
// ------------------------------------------------------------

model FichaMesaEntrada {
  idFichaMesaEntrada                  String   @id @default(cuid())
  usuarioId                           String?  @unique
  activoFichaMesaEntrada              Boolean  @default(true)
  nombreFichaMesaEntrada              String
  apellidoFichaMesaEntrada            String
  // normalizarTexto(): orden y búsqueda del listado (P-F1), igual que Profesor.
  nombreNormalizadoFichaMesaEntrada   String
  apellidoNormalizadoFichaMesaEntrada String
  dniFichaMesaEntrada                 String   @unique
  fechaNacimientoFichaMesaEntrada     DateTime @db.Date
  generoFichaMesaEntrada              Genero?
  telefonoFichaMesaEntrada            String?
  emailFichaMesaEntrada               String
  creadoPorUsuarioId                  String?
  modificadoPorUsuarioId              String?
  createdAtFichaMesaEntrada           DateTime @default(now())
  updatedAtFichaMesaEntrada           DateTime @updatedAt
  // Concurrencia optimista (Regla N.° 7).
  version                             Int      @default(0)

  usuario Usuario? @relation(fields: [usuarioId], references: [idUsuario], onDelete: SetNull)

  @@index([apellidoNormalizadoFichaMesaEntrada, nombreNormalizadoFichaMesaEntrada, dniFichaMesaEntrada], map: "fichas_mesa_entrada_orden_listado_idx")
  @@map("fichas_mesa_entrada")
}

model FichaGerente {
  idFichaGerente                  String   @id @default(cuid())
  usuarioId                       String?  @unique
  activoFichaGerente              Boolean  @default(true)
  nombreFichaGerente              String
  apellidoFichaGerente            String
  nombreNormalizadoFichaGerente   String
  apellidoNormalizadoFichaGerente String
  dniFichaGerente                 String   @unique
  fechaNacimientoFichaGerente     DateTime @db.Date
  generoFichaGerente              Genero?
  telefonoFichaGerente            String?
  emailFichaGerente               String
  creadoPorUsuarioId              String?
  modificadoPorUsuarioId          String?
  createdAtFichaGerente           DateTime @default(now())
  updatedAtFichaGerente           DateTime @updatedAt
  version                         Int      @default(0)

  usuario Usuario? @relation(fields: [usuarioId], references: [idUsuario], onDelete: SetNull)

  @@index([apellidoNormalizadoFichaGerente, nombreNormalizadoFichaGerente, dniFichaGerente], map: "fichas_gerente_orden_listado_idx")
  @@map("fichas_gerente")
}

# Copiar este archivo a .env y completar los valores. NO commitear .env.

# Conexión a PostgreSQL. Con el docker-compose.yml del repo los valores son:
#   postgresql://noctium:noctium@localhost:5433/noctium_dev
DATABASE_URL="postgresql://usuario:password@localhost:PUERTO/NOMBRE_DB"

# Secreto para firmar los JWT de sesión (NextAuth). Generar con: npx auth secret
AUTH_SECRET="generar con: npx auth secret"

# Opcional: solo necesario si se corre con `next start` (producción) en vez de
# `next dev`; sin esto NextAuth responde UntrustedHost en /api/auth/*.
# AUTH_URL="http://localhost:3000"

# Secreto de HMAC-SHA256 para el código OTP de autorregistro (HU-B-08,
# spec_modulo_B.md §3.6, RULES.md Regla N.° 9). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODIGO_OTP_SECRET="generar con el comando de arriba"

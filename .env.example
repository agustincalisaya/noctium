# Copiar este archivo a .env y completar los valores. NO commitear .env.

# Conexión a PostgreSQL. Con el docker-compose.yml del repo los valores son:
#   postgresql://noctium:noctium@localhost:5433/noctium_dev
DATABASE_URL="postgresql://usuario:password@localhost:PUERTO/NOMBRE_DB"

# Secreto para firmar los JWT de sesión (NextAuth). Generar con: npx auth secret
AUTH_SECRET="generar con: npx auth secret"

# Opcional: solo necesario si se corre con `next start` (producción) en vez de
# `next dev`; sin esto NextAuth responde UntrustedHost en /api/auth/*.
# AUTH_URL="http://localhost:3000"

# Secreto de HMAC-SHA256 para el código OTP de autorregistro (HU-B-08,
# spec_modulo_B.md §3.6, RULES.md Regla N.° 9). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODIGO_OTP_SECRET="generar con el comando de arriba"

# ------------------------------------------------------------
# Sprint 3 (PR-0.md §2.11, RULES.md Regla N.° 9). Ningún secreto va en el
# código ni en el seed.
# ------------------------------------------------------------

# URL pública del sistema. NextAuth ya la usa (acepta NEXTAUTH_URL o AUTH_URL)
# y los enlaces de «¿Olvidaste tu contraseña?» (HU-A-05) se arman con ella.
NEXTAUTH_URL="http://localhost:3000"

# Envío de emails con Resend (HU-A-05). Opcional (decisión del PO): sin
# RESEND_API_KEY el servicio de email usa el simulador, que muestra el enlace
# en la consola de `next dev`. EMAIL_FROM solo se usa si hay RESEND_API_KEY.
RESEND_API_KEY=""
EMAIL_FROM=""

# Secreto del endpoint del proceso programado de vencimiento de reservas
# (HU-C-24): sin él el endpoint responde 401. Generar con el mismo comando que
# CODIGO_OTP_SECRET.
CRON_SECRET="generar con el comando de CODIGO_OTP_SECRET"

# La zona horaria del centro (America/Argentina/Buenos_Aires) es una constante
# del módulo de fechas, no una variable de entorno (PR-0.md §2.2).
